{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Multi-tenant Entra sign-in.
  //
  // TenantId is deliberately "organizations", not a tenant guid: the app is installed
  // into each customer's tenant as an Enterprise Application, and the tenant of any
  // given request is whichever one the signed-in user belongs to.
  //
  // No credential here. This is a confidential client, so redeeming the authorization
  // code requires the app to authenticate itself - but how it does that differs by
  // environment:
  //   Local dev  -> a client secret in User Secrets (AzureAd:ClientSecret).
  //                 A dev machine has no managed identity, so a secret is the option.
  //   Production -> workload identity federation, see appsettings.Production.json.
  //                 No secret exists anywhere.
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "organizations",
    "ClientId": "SET-IN-USER-SECRETS",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "MetricsCollection": {
    "Enabled": true,
    "IntervalHours": 6,
    "Source": "Graph",
    "StaleDataThresholdHours": 12
  },

  // Delegated scopes. The effective access is the intersection of these and the
  // signed-in user's own directory privileges.
  "GraphApi": {
    "Scopes": [ "User.Read.All", "Group.Read.All", "Device.Read.All" ],
    "PageSize": 999,
    "MaxRetries": 3,
    "RetryDelayMilliseconds": 1000,
    "TimeoutSeconds": 30
  }
}
