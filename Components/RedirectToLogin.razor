@inject NavigationManager Navigation

@code {
    // Sends an unauthenticated visitor to the Microsoft Identity sign-in endpoint,
    // preserving where they were trying to go so they land back there afterwards.
    protected override void OnInitialized()
    {
        var returnUrl = Uri.EscapeDataString(
            Navigation.ToBaseRelativePath(Navigation.Uri));

        Navigation.NavigateTo(
            $"MicrosoftIdentity/Account/SignIn?redirectUri=/{returnUrl}",
            forceLoad: true);
    }
}
