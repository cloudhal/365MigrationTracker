<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>_365MigrationTracker</RootNamespace>
    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>420dff05-5481-4e10-ba77-5835df6135a9</UserSecretsId>
  </PropertyGroup>

  <!--
    The test project lives in a subdirectory of this one, and the Web SDK globs **/*.cs
    by default. Without these excludes the web project would try to compile the tests
    (and fail with duplicate-item errors once both projects build).

    The tests were previously inside this project, which is why they could never run:
    the test host cannot load a Web SDK project as a test assembly.
  -->
  <ItemGroup>
    <Compile Remove="365MigrationTracker.Tests\**" />
    <Content Remove="365MigrationTracker.Tests\**" />
    <None Remove="365MigrationTracker.Tests\**" />
    <EmbeddedResource Remove="365MigrationTracker.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.Storage" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
    <PackageReference Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

</Project>
