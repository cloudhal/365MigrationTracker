{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "_365MigrationTracker": "Information"
    }
  },
  "MetricsCollection": {
    "Enabled": true,
    "IntervalHours": 6,
    "Source": "Graph",
    "StaleDataThresholdHours": 12
  }
}
