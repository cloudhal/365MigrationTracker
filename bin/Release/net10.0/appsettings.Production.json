{
  // Production credentials: none.
  //
  // Instead of a client secret, App Service authenticates to Entra using workload
  // identity federation. The platform hands the app a token for its own managed
  // identity, Microsoft.Identity.Web exchanges that for an app token, and the
  // authorization-code redemption is authenticated with no stored secret at all.
  //
  // Nothing here is sensitive, which is the point - there is no secret to rotate,
  // expire, leak into logs, or paste into App Service configuration.
  //
  // Requires, on the Azure side:
  //   1. A managed identity on the App Service (System assigned = On is simplest)
  //   2. On the app registration: Certificates & secrets -> Federated credentials
  //      -> Add credential -> scenario "Managed identity", pointing at that identity
  //
  // For a USER-assigned managed identity instead, add its client id:
  //   "ManagedIdentityClientId": "<user assigned managed identity client id>"
  // Omitting it, as below, uses the system-assigned identity.
  "AzureAd": {
    "ClientCredentials": [
      {
        "SourceType": "SignedAssertionFromManagedIdentity"
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "_365MigrationTracker": "Information"
    }
  }
}
