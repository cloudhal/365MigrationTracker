@inherits LayoutComponentBase
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JS
@inject IGraphAccessProvider GraphAccess
@inject NavigationManager Navigation

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Name="IsDarkMode" Value="_isDarkMode">
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="MudBlazor.Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="px-4">365 Migration Tracker</MudText>
        <MudSpacer />

        @* Displays the organisation logo in top left using CSS *@
        @* <Logo /> *@

        @* Dark mode button *@
        <MudToggleIconButton @bind-Toggled="_isDarkMode" @bind-Toggled:after="OnDarkModeToggled"
        Icon="@Icons.Material.Outlined.DarkMode" Color="@MudBlazor.Color.Inherit"
        ToggledIcon="@Icons.Material.Filled.WbSunny"
        title="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")" />

        @* Refresh data button *@
        @* <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="MudBlazor.Color.Inherit" Title="Refresh data" OnClick="RefreshDataClicked" /> *@

        @*Settings button*@
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="MudBlazor.Color.Inherit" OnClick="SettingsButtonClicked">Settings</MudIconButton>
        @*Settings message box*@
        <MudMessageBox @ref="settingsmbox" Title="Settings" CancelText="">
            <MessageContent>
                <div style="max-height: 60vh; overflow-y: auto;">
                    <MudGrid>
                    </MudGrid>
                </div>
            </MessageContent>
            <YesButton>
                <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Success">OK</MudButton>
            </YesButton>
        </MudMessageBox>

        @* About message box*@
        @* <About /> *@

        @* Signed-in user, with sign out. *@
        <AuthorizeView Context="auth">
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    @* A photo needs ActivatorContent, because MudMenu's built-in activator
                       only accepts an icon name.

                       MudMenu does NOT wire a click onto ActivatorContent - its wrapper div
                       has @onkeydown only. Instead it hands the content a MenuContext, and
                       the content is responsible for calling ToggleAsync. That is why both
                       a MudButton and a bare MudStack here did nothing.

                       A plain div, not a MudStack: @onclick binds to elements, whereas on a
                       component it would need an explicit parameter to be honoured. *@
                    <ActivatorContent Context="menu">
                        @* Avatar only - the name and email live in the popup. *@
                        <div class="d-flex align-center px-2"
                             style="cursor: pointer;"
                             title="@GetDisplayName(auth.User)"
                             @onclick="@(() => menu.ToggleAsync())">
                            @if (_photoDataUri is not null)
                            {
                                <MudAvatar Size="Size.Small">
                                    <MudImage Src="@_photoDataUri" Alt="Profile photo" />
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Size="Size.Small" Color="MudBlazor.Color.Primary">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                </MudAvatar>
                            }
                        </div>
                    </ActivatorContent>

                    <ChildContent>
                        <MudPaper Elevation="0" Class="pa-4" Style="min-width: 280px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
                                @if (_photoDataUri is not null)
                                {
                                    <MudAvatar Size="Size.Medium">
                                        <MudImage Src="@_photoDataUri" Alt="Profile photo" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Size="Size.Medium" Color="MudBlazor.Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                    </MudAvatar>
                                }
                                <div>
                                    <MudText Typo="Typo.subtitle1">@GetDisplayName(auth.User)</MudText>
                                    <MudText Typo="Typo.body2">@auth.User.Identity?.Name</MudText>
                                    <MudText Typo="Typo.caption">Tenant ID: @GetTenantId(auth.User)</MudText>
                                </div>
                            </MudStack>

                            <MudDivider Class="mb-3" />

                            @* OnClick rather than Href: sign-out is a server endpoint, not
                               a Blazor route, so it needs a forced full navigation.
                               MudButton has no ForceLoad parameter - it is only on
                               MudMenuItem - and passing one is silently ignored. *@
                            <MudButton OnClick="SignOut"
                                       Variant="Variant.Filled"
                                       Color="MudBlazor.Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Logout"
                                       FullWidth="true">
                                Sign out
                            </MudButton>
                        </MudPaper>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="MicrosoftIdentity/Account/SignIn"
                           Variant="Variant.Text"
                           Color="MudBlazor.Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login">
                    Sign in
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudDrawerHeader Class="@headerStyle"></MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer Class="mt-5 px-8" MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent>
    <MudScrollToTop>
        <MudFab Color="MudBlazor.Color.Tertiary" StartIcon="@Icons.Material.Filled.ArrowCircleUp" />
    </MudScrollToTop>
</MudLayout>
</CascadingValue>

@*Drawer*@
@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    int currentYear = DateTime.Now.Year;

@*Dark  mode button*@
    private MudTheme _theme = new();
    private bool _isDarkMode;
    string headerStyle = "drawer-image-dark";

    private const string DarkModeStorageKey = "darkmode";

    // The "name" claim carries the display name. Identity.Name is the UPN/email, since
    // Microsoft.Identity.Web maps it from preferred_username - so the two are different
    // things and the popup shows both.
    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst("name")?.Value
        ?? user.Identity?.Name
        ?? "Signed in";

    // Shown in the account menu so it is obvious whose tenant the figures belong to -
    // useful when supporting a customer and when several tenants are in play.
    private static string GetTenantId(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst("http://schemas.microsoft.com/identity/claims/tenantid")?.Value
        ?? user.FindFirst("tid")?.Value
        ?? "unknown";

    // Runs after @bind-Toggled has already flipped _isDarkMode, so this only
    // persists the new value - it must not toggle it again.
    private async Task OnDarkModeToggled()
    {
        headerStyle = _isDarkMode ? "drawer-image-light" : "drawer-image-dark";

        try
        {
            await LocalStorage.SetItemAsync(DarkModeStorageKey, _isDarkMode);
        }
        catch (Exception)
        {
            // Storage can be unavailable (private browsing, blocked site data).
            // The toggle still works for this session; it just won't be remembered.
        }
    }

    // Clear all data caches, then reload so every tile re-fetches from Graph.
    // Settings (dark mode, component toggles, SharePoint total, expanded tiles) are preserved.
    @* private async Task RefreshDataClicked()
    {
        foreach (var key in CacheKeys.Data)
        {
            await localStorage.RemoveItemAsync(key);
        }
        await JS.InvokeVoidAsync("location.reload");
    } *@

    @*Settings message box*@
    MudMessageBox? settingsmbox { get; set; }
    string settingsmboxstate = "Message box hasn't been opened yet";


    private async void SettingsButtonClicked()
    {
        @* RefreshSelection(); // reflect current state each time the dialog opens *@
        bool? result = await settingsmbox.ShowAsync();
        settingsmboxstate= result==null ? "Cancelled" : "Deleted!";
        StateHasChanged();
    }
    MudForm? settingsForm;


    private bool _preloadCleared;

    // Cached for the life of the circuit. The photo is a few KB of base64 and does not
    // change during a session, so it is fetched once rather than on every render.
    private string? _photoDataUri;

    private void SignOut() =>
        Navigation.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);

    // localStorage is only reachable once the circuit is live - JS interop cannot run
    // during server-side prerendering - so the saved preference is read on first render
    // rather than in OnInitializedAsync. Until then the pre-paint class in App.razor is
    // what's holding the dark palette in place.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Fetched here rather than in OnInitializedAsync so it happens once the
            // circuit is live, and so a slow Graph call cannot delay first paint.
            var photo = await GraphAccess.GetUserPhotoDataUriAsync();
            if (photo is not null)
            {
                _photoDataUri = photo;
                StateHasChanged();
            }

            bool saved = false;
            try
            {
                saved = await LocalStorage.GetItemAsync<bool>(DarkModeStorageKey);
            }
            catch (Exception)
            {
                // No stored preference, or storage unavailable - keep the light-mode default.
            }

            if (saved != _isDarkMode)
            {
                _isDarkMode = saved;
                headerStyle = _isDarkMode ? "drawer-image-light" : "drawer-image-dark";
                StateHasChanged();

                // Hand off to the next render pass: the preload class must stay until
                // MudThemeProvider has actually painted dark, or removing it flashes light.
                return;
            }
        }

        if (!_preloadCleared)
        {
            _preloadCleared = true;
            try
            {
                await JS.InvokeVoidAsync("clearDarkModePreload");
            }
            catch (Exception)
            {
                // Non-fatal: the class only overrides palette variables that
                // MudThemeProvider is now setting to the same values anyway.
            }
        }
    }
    // Reset all settings to defaults
    private async Task ResetAllSettings()
    {
        @* await localStorage.ClearAsync(); // Reset localStorage (dark mode, caches, toggles)
        await Settings.ResetAsync(); // Reset in-memory toggles to enabled and notify the dashboard *@
    }

    MudMessageBox? aboutmbox { get; set; }
    string aboutstate = "Message box hasn't been opened yet";

    private async void AboutButtonClicked()
    {
        bool? result = await aboutmbox.ShowAsync();
        aboutstate= result==null ? "Cancelled" : "Deleted!";
        StateHasChanged();
    }

}